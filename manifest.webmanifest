{
  "name": "OmniConvert",
  "short_name": "OmniConvert",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#07080d",
  "theme_color": "#07080d",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            "text/csv",
            "application/json",
            "text/plain"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp",
          ".gif"
        ],
        "video/*": [
          ".mp4",
          ".webm",
          ".mov"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".ogg",
          ".flac"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt",
          ".csv",
          ".json",
          ".md",
          ".log"
        ]
      }
    }
  ]
}