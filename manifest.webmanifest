{
  "name": "OmniConvert",
  "short_name": "OmniConvert",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f3f1ec",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "audio/*", "application/pdf", "text/csv", "application/json", "text/plain"]
        }
      ]
    }
  }
}